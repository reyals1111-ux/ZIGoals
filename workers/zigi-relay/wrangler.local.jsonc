{
  "$schema": "../../apps/web/node_modules/wrangler/config-schema.json",
  "name": "zigoals-zigi-relay-local",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-13",
  "durable_objects": {
    "bindings": [
      {
        "name": "ZIGI_BUDGET",
        "class_name": "RelayBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RelayBudget"
      ]
    }
  ],
  "vars": {
    "AUTH_ORIGIN": "https://unconfigured.supabase.co",
    "APP_ORIGIN": "http://127.0.0.1:3110",
    "ZIGI_UPSTREAM_URL": "https://api.openai.com/v1/chat/completions",
    "ZIGI_PROVIDER_NAME": "OpenAI",
    "ZIGI_MODEL": "gpt-6-luna",
    "ZIGI_DAILY_REQUESTS": "40",
    "ZIGI_DAILY_TOKENS": "150000",
    "ZIGI_GLOBAL_DAILY_TOKENS": "1500000",
    "ZIGI_KILL_SWITCH": "on"
  },
  "observability": {
    "enabled": false
  },
  "workers_dev": false,
  "preview_urls": false
}
