{
  // Session X Part 9: the relay template for the Anthropic upstream (docs/run11/ZIGI_RELAY_ACTIVATION.md, "Anthropic").
  // The same Worker as wrangler.local.jsonc (the OpenAI default, unchanged); only the provider's vars differ.
  // Session Z-Cloud Part 6 (ADR-019 C40), "ZIGoals AI · powered by Claude" for friends: Claude Sonnet 5.5 ($2 / $10 per
  // million input / output tokens; cache writes $2.50, cache reads $0.10: Z-Local's lib/ai/pricing.ts, read 2026-10-10);
  // Claude Haiku 5.5 ("claude-haiku-5-5") is the one other model the relay accepts. Per friend: 40 messages a day and 600
  // a month, $1 a day and $10 a month, counted from each reply's own usage (cache included); $20 a day for the whole
  // relay. The token budgets stay as a second guard, sized so cached prompts (about 12,500 tokens each) never bind first.
  // Thinking is the model's own adaptive default (the 5.5 models refuse "disabled"); depth comes from the effort.
  "$schema": "../../apps/web/node_modules/wrangler/config-schema.json",
  "name": "zigoals-zigi-relay-anthropic-local",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-13",
  "durable_objects": {
    "bindings": [
      {
        "name": "ZIGI_BUDGET",
        "class_name": "RelayBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RelayBudget"
      ]
    }
  ],
  "vars": {
    "AUTH_ORIGIN": "https://unconfigured.supabase.co",
    "APP_ORIGIN": "http://127.0.0.1:3110",
    "ZIGI_UPSTREAM_URL": "https://api.anthropic.com/v1/messages",
    "ZIGI_PROVIDER_NAME": "Anthropic",
    "ZIGI_MODEL": "claude-sonnet-5-5",
    "ZIGI_DAILY_REQUESTS": "40",
    "ZIGI_MONTHLY_REQUESTS": "600",
    "ZIGI_DAILY_TOKENS": "1500000",
    "ZIGI_GLOBAL_DAILY_TOKENS": "15000000",
    "ZIGI_DAILY_USD": "1",
    "ZIGI_MONTHLY_USD": "10",
    "ZIGI_GLOBAL_DAILY_USD": "20",
    "ZIGI_KILL_SWITCH": "on"
  },
  "observability": {
    "enabled": false
  },
  "workers_dev": false,
  "preview_urls": false
}
