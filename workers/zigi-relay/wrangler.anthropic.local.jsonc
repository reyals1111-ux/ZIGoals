{
  // Session X Part 9: the relay template for the Anthropic upstream (docs/run11/ZIGI_RELAY_ACTIVATION.md, "Anthropic").
  // The same Worker as wrangler.local.jsonc (the OpenAI default, unchanged); only the provider's vars differ. The model is
  // Claude Haiku 5.5, Anthropic's lowest-priced current model ($0.10 / $0.50 per million input / output tokens for
  // prompts up to 100,000 tokens; platform.claude.com models overview and pricing, read 2026-10-08). Thinking stays off.
  "$schema": "../../apps/web/node_modules/wrangler/config-schema.json",
  "name": "zigoals-zigi-relay-anthropic-local",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-13",
  "durable_objects": {
    "bindings": [
      {
        "name": "ZIGI_BUDGET",
        "class_name": "RelayBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RelayBudget"
      ]
    }
  ],
  "vars": {
    "AUTH_ORIGIN": "https://unconfigured.supabase.co",
    "APP_ORIGIN": "http://127.0.0.1:3110",
    "ZIGI_UPSTREAM_URL": "https://api.anthropic.com/v1/messages",
    "ZIGI_PROVIDER_NAME": "Anthropic",
    "ZIGI_MODEL": "claude-haiku-5-5",
    "ZIGI_THINKING": "off",
    "ZIGI_DAILY_REQUESTS": "40",
    "ZIGI_DAILY_TOKENS": "150000",
    "ZIGI_GLOBAL_DAILY_TOKENS": "1500000",
    "ZIGI_KILL_SWITCH": "on"
  },
  "observability": {
    "enabled": false
  },
  "workers_dev": false,
  "preview_urls": false
}
