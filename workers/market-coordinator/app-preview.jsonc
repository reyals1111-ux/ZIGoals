{
 "$schema":"../../apps/web/node_modules/wrangler/config-schema.json",
 "name":"zigoals-market-app-local",
 "main":"../../apps/web/.open-next/worker.js",
 "compatibility_date":"2026-09-13",
 "compatibility_flags":["nodejs_compat","global_fetch_strictly_public"],
 "workers_dev":false,
 "preview_urls":false,
 "assets":{"directory":"../../apps/web/.open-next/assets","binding":"ASSETS","run_worker_first":false},
 "services":[
  {"binding":"WORKER_SELF_REFERENCE","service":"zigoals-market-app-local"},
  {"binding":"MARKET_QUOTES","service":"zigoals-market-coordinator-local","entrypoint":"QuoteService"}
 ],
 "vars":{"ZIGOALS_MARKET_QUOTES_MODE":"durable-v1"},
 "observability":{"enabled":false}
}
