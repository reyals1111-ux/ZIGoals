{
  "$schema": "../../apps/web/node_modules/wrangler/config-schema.json",
  "name": "zigoals-push-device-local",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-13",
  "durable_objects": {
    "bindings": [
      { "name": "PUSH_DEVICES", "class_name": "PushDevice" },
      { "name": "PUSH_BUDGET", "class_name": "PushBudget" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PushDevice", "PushBudget"] }
  ],
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:3110",
    "VAPID_SUBJECT": "mailto:hello@zigoals.app",
    "KILL_SWITCH": "on"
  },
  "observability": { "enabled": false },
  "workers_dev": false,
  "preview_urls": false
}
