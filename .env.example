# Optional local telemetry setting. No wallet or deployment credentials belong here.
NEXT_TELEMETRY_DISABLED=1
# Deployment configuration is the reviewed PUBLIC apps/web/config/deployment.json.
# Legacy NEXT_PUBLIC_GOAL_MANAGER_ADDRESS/CODE_ID variables are not consumed.
# Never place mnemonics, signing keys or private plans in environment files.

# Optional CoinGecko Demo key: SERVER ONLY, in apps/web/.env.local (gitignored).
# Never prefix with NEXT_PUBLIC_, print it, or put it in a URL. See docs/RUN_9_MARKET_DATA.md.
COINGECKO_DEMO_API_KEY=
